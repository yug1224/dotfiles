{
  "permissions": {
    "allow": ["Bash(*)", "mcp__codegraph__*"],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh run delete:*)",
      "Bash(gh repo archive:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-shell.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "ponytail@ponytail": true,
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/cursor/plugins.git"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "git",
        "url": "https://github.com/nanaism/yomiyasu.git"
      }
    }
  },
  "effortLevel": "xhigh",
  "switchModelsOnFlag": true
}
