{
  "permissions": {
    "allow": [
      "Bash(*)",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh run delete:*)",
      "Bash(gh repo archive:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-shell.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "git",
        "url": "https://github.com/DietrichGebert/ponytail.git",
        "ref": "96608e078b2d5ea607c5c3b8b5a54d1c1fba6846"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/cursor/plugins.git",
        "ref": "d42aff08aa58965d2735c4ead61a9af82b89d0d0"
      }
    }
  },
  "effortLevel": "xhigh",
  "switchModelsOnFlag": true
}
